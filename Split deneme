static size_t	get_word_end(char const *s, char c, size_t i)
{
	while (s[i] && s[i] != c)
		i++;
	return (i);
}

static int	fill_result(char **result, char const *s, char c)
{
	size_t	i;
	size_t	index;
	size_t	start;

	i = 0;
	index = 0;
	while (s[i])
	{
		while (s[i] == c)
			i++;
		if (s[i])
		{
			start = i;
			i = get_word_end(s, c, i);
			result[index] = ft_substr(s, start, i - start);
			if (!result[index])
				return (ftfree(result, index), 0);
			index++;
		}
		i++;
	}
	result[index] = NULL;
	return (1);
}

char	**ft_split(char const *s, char c)
{
	char	**result;

	result = malloc(sizeof(char *) * (words_count(s, c) + 1));
	if (!result)
		return (NULL);
	if (!fill_result(result, s, c))
		return (NULL);
	return (result);
}
