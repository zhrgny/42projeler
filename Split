static size_t	words(char const *s, char c)
{
	size_t	i;
	size_t	words;

	i = 0;
	words = 0;
	while (s[i])
	{
		if ((s[i] != c) && (i == 0 || (s[i - 1] == c)))
			words++;
		i++;
	}
	return (words);
}

static void	free_result(char **result, size_t index)
{
	while (index > 0)
	{
		index--;
		free(result[index]);
	}
	free(result);
}

static int	fill_words(char const *s, char c, char **result)
{
	size_t	i;
	size_t	index;
	size_t	start;

	i = 0;
	index = 0;
	while (s[i])
	{
		while (s[i] == c)
			i++;
		if (s[i])
		{
			start = i;
			while (s[i] && (s[i] != c))
				i++;
			result[index] = ft_substr(s, start, i - start);
			if (!result[index])
			{
				free_result(result, index);
				return (0);
			}
			index++;
		}
	}
	result[index] = NULL;
	return (1);
}

char	**ft_split(char const *s, char c)
{
	char	**result;

	result = malloc(sizeof(char *) * (words(s, c) + 1));
	if (!result)
		return (NULL);
	if (!fill_words(s, c, result))
		return (NULL);
	return (result);
}
